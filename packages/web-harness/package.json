{
	"name": "hasilan-code",
	"version": "0.1.7",
	"private": true,
	"description": "Local authenticated web harness for Pi sessions, teams, browser tools and user terminals",
	"type": "module",
	"license": "MIT",
	"bin": {
		"hasilan-code": "bin/hasilan-code.mjs"
	},
	"files": [
		"bin",
		"dist",
		"README.md",
		"LICENSE"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/seipass/hasilan-code.git",
		"directory": "packages/web-harness"
	},
	"homepage": "https://github.com/seipass/hasilan-code",
	"bugs": {
		"url": "https://github.com/seipass/hasilan-code/issues"
	},
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org"
	},
	"hasilanCode": {
		"piVersion": "1.5.0",
		"piCommit": "f9a26365568127461c47a07a37dcb42c140a3ac5"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"scripts": {
		"clean": "shx rm -rf dist",
		"build": "tsc -p tsconfig.build.json && vite build",
		"start": "node bin/hasilan-code.mjs",
		"test": "vitest --run",
		"typecheck": "tsc -p tsconfig.test.json && tsc -p tsconfig.client.json",
		"prepublishOnly": "node -e \"throw new Error('Publish the verified tarball from npm run pack:hasilan, not this workspace')\""
	},
	"dependencies": {
		"proper-lockfile": "4.1.2",
		"@hasilan-code/pi-agent-core": "1.5.0",
		"@hasilan-code/pi-ai": "1.5.0",
		"@hasilan-code/pi-coding-agent": "1.5.0",
		"@xterm/addon-serialize": "0.14.0",
		"@xterm/headless": "6.0.0",
		"music-metadata": "12.2.3",
		"node-pty": "1.1.0",
		"playwright": "1.64.0",
		"qrcode": "1.5.4",
		"strtok3": "10.6.2",
		"typebox": "1.3.27",
		"typescript": "7.0.2",
		"ws": "8.22.0",
		"xxhashjs": "0.2.2"
	},
	"devDependencies": {
		"@types/proper-lockfile": "4.1.4",
		"@codemirror/autocomplete": "6.20.4",
		"@codemirror/commands": "6.11.1",
		"@codemirror/language": "6.13.1",
		"@codemirror/language-data": "6.5.2",
		"@codemirror/state": "6.7.6",
		"@codemirror/view": "6.43.15",
		"@lezer/highlight": "1.2.5",
		"@types/node": "22.19.19",
		"@types/qrcode": "1.5.6",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@types/ws": "8.18.2",
		"@types/xxhashjs": "0.2.4",
		"@vitejs/plugin-react": "6.1.2",
		"@xterm/addon-fit": "0.11.0",
		"@xterm/xterm": "6.0.0",
		"codemirror": "6.0.2",
		"gen-interface-jp": "0.8.0",
		"highlight.js": "11.12.0",
		"react": "19.3.0",
		"react-dom": "19.3.0",
		"react-markdown": "10.1.0",
		"remark-gfm": "4.0.1",
		"shx": "0.3.4",
		"vite": "8.3.4",
		"vitest": "4.1.11"
	}
