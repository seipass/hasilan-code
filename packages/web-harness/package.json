{
	"name": "hasilan-code",
	"version": "1.1.0",
	"private": true,
	"description": "Local authenticated web harness for Pi sessions, teams, browser tools and user terminals",
	"type": "module",
	"license": "MIT",
	"engines": { "node": ">=22.19.0" },
	"scripts": {
		"clean": "shx rm -rf dist",
		"build": "tsc -p tsconfig.build.json && vite build",
		"start": "node dist/server/main.js",
		"test": "vitest --run",
		"typecheck": "tsc -p tsconfig.test.json && tsc -p tsconfig.client.json"
	},
	"dependencies": {
		"@earendil-works/pi-agent-core": "1.1.0",
		"@earendil-works/pi-ai": "1.1.0",
		"@earendil-works/pi-coding-agent": "1.1.0",
		"@xterm/addon-fit": "0.11.0",
		"@xterm/addon-serialize": "0.14.0",
		"@xterm/headless": "6.0.0",
		"@xterm/xterm": "6.0.0",
		"node-pty": "1.1.0",
		"playwright": "1.64.0",
		"react": "19.3.0",
		"react-dom": "19.3.0",
		"react-markdown": "10.1.0",
		"remark-gfm": "4.0.1",
		"typebox": "1.3.27",
		"ws": "8.22.0",
		"xxhashjs": "0.2.2"
	},
	"devDependencies": {
		"@types/node": "22.19.19",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@types/ws": "8.18.2",
		"@types/xxhashjs": "0.2.4",
		"@vitejs/plugin-react": "6.1.2",
		"shx": "0.3.4",
		"typescript": "7.0.2",
		"vite": "8.3.4",
		"vitest": "4.1.11"
	}
}
